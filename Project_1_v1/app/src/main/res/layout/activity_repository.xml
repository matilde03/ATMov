<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".RepositoryActivity">

    <!-- Repository toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarRepository"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:background="?attr/colorPrimaryContainer"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"

        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/repository_title"

        app:title="@string/repository_title"

        app:menu="@menu/repository_menu"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Scrollable repository content -->
    <ScrollView
        android:id="@+id/scrollRepository"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="false"

        app:layout_constraintTop_toBottomOf="@id/toolbarRepository"
        app:layout_constraintBottom_toTopOf="@id/btnClearHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">


            <!-- Temperature history card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cwTempHistory"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardCornerRadius="16dp"
                app:contentPadding="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iwTempHistory"

                        android:layout_width="48dp"
                        android:layout_height="48dp"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"

                        android:src="@drawable/ic_thermostat"
                        android:contentDescription="@string/sensor_temperature"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvTempTitle"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"

                        android:text="@string/sensor_temperature"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"

                        app:layout_constraintTop_toTopOf="@id/iwTempHistory"
                        app:layout_constraintBottom_toBottomOf="@id/iwTempHistory"
                        app:layout_constraintStart_toEndOf="@id/iwTempHistory"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvTempHistory"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"

                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"

                        app:layout_constraintTop_toBottomOf="@id/iwTempHistory"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"

                        tools:text="23.5 °C | 17/10/2026 14:35:00" />

                    <Button
                        android:id="@+id/btnClearTemp"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"

                        android:text="@string/clear_temperature_history"

                        app:cornerRadius="16dp"

                        app:layout_constraintTop_toBottomOf="@id/tvTempHistory"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>


            <!-- Humidity history card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cwHumHistory"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                app:cardCornerRadius="16dp"
                app:contentPadding="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iwHumHistory"

                        android:layout_width="48dp"
                        android:layout_height="48dp"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"

                        android:src="@drawable/ic_water_drop"
                        android:contentDescription="@string/sensor_humidity"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvHumTitle"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"

                        android:text="@string/sensor_humidity"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"

                        app:layout_constraintTop_toTopOf="@id/iwHumHistory"
                        app:layout_constraintBottom_toBottomOf="@id/iwHumHistory"
                        app:layout_constraintStart_toEndOf="@id/iwHumHistory"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvHumHistory"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"

                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"

                        app:layout_constraintTop_toBottomOf="@id/iwHumHistory"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"

                        tools:text="65 % | 17/10/2026 14:35:00" />

                    <Button
                        android:id="@+id/btnClearHum"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"

                        android:text="@string/clear_humidity_history"

                        app:cornerRadius="16dp"

                        app:layout_constraintTop_toBottomOf="@id/tvHumHistory"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>


            <!-- Luminosity history card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cwLumHistory"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                app:cardCornerRadius="16dp"
                app:contentPadding="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iwLumHistory"

                        android:layout_width="48dp"
                        android:layout_height="48dp"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"

                        android:src="@drawable/ic_light_mode"
                        android:contentDescription="@string/sensor_luminosity"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvLumTitle"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"

                        android:text="@string/sensor_luminosity"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"

                        app:layout_constraintTop_toTopOf="@id/iwLumHistory"
                        app:layout_constraintBottom_toBottomOf="@id/iwLumHistory"
                        app:layout_constraintStart_toEndOf="@id/iwLumHistory"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvLumHistory"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"

                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"

                        app:layout_constraintTop_toBottomOf="@id/iwLumHistory"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"

                        tools:text="450 lx | 17/10/2026 14:35:00" />

                    <Button
                        android:id="@+id/btnClearLum"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"

                        android:text="@string/clear_luminosity_history"

                        app:cornerRadius="16dp"

                        app:layout_constraintTop_toBottomOf="@id/tvLumHistory"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>


    <!-- Clear all repository history -->
    <Button
        android:id="@+id/btnClearHistory"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"

        android:text="@string/clear_repository"

        app:cornerRadius="16dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>